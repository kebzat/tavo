APP_NAME=Taveo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=cs
APP_FALLBACK_LOCALE=cs
APP_FAKER_LOCALE=cs_CZ

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tavo
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Odesílání poptávek. Lokálně `log` — e-mail se vypíše do storage/logs/laravel.log
# a nikam neodejde. Na produkci Resend přes SMTP: v resend.com/api-keys vytvoř
# klíč a vlož ho jako MAIL_PASSWORD. Doména taveo.cz musí být v Resendu ověřená
# (DKIM a SPF záznamy v DNS), jinak odesílání skončí chybou.
#
# Pozor: `MAIL_MAILER=resend` tady nefunguje, chybí k němu balíček
# resend/resend-php. Resend se používá přes SMTP, viz řádky níž.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.resend.com
# MAIL_PORT=587
# MAIL_USERNAME=resend
# MAIL_PASSWORD=re_xxxxxxxxxxxxxxxxxxxx
# MAIL_FROM_ADDRESS musí být na doméně ověřené v Resendu.
MAIL_FROM_ADDRESS="spoluprace@taveo.cz"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

APP_TIMEZONE=Europe/Prague

# Interní CRM (panel /nastroje)
# Účty, které založí `php artisan db:seed --class=CrmSeeder`.
# Formát: "Jméno:email:heslo,Jméno:email:heslo"
CRM_USERS=
# Token pro strojové endpointy /nastroje/api/… (import poptávek, export pipeline).
# Prázdný token je vypíná, endpointy pak vracejí 404.
CRM_IMPORT_TOKEN=
# Claude API pro úsudek nad prospekty, shrnutí auditu a týdenní hledání firem
# (crm:discover). Bez klíče jede proklepnutí webu jen z měření.
ANTHROPIC_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Jen když klíč nepatří žádnému workspace (API pak vrací „must include the
# anthropic-workspace-id header"). Jednodušší je vytvořit klíč přímo ve workspace.
ANTHROPIC_WORKSPACE_ID=
# Google PageSpeed při proklepnutí webu. Bez klíče narazí na sdílený denní limit
# a rychlost se do auditu nedostane. Klíč: Google Cloud → APIs → PageSpeed Insights API.
PAGESPEED_API_KEY=
PAGESPEED_ENABLED=true
# Jen lokálně: CRM_IMPORT_TOKEN z produkce. Skill /audit-eshopu v Claude Code
# s ním nahraje hotový audit do ostrého CRM.
TAVEO_PROD_CRM_TOKEN=

# Reklamy klientů (panel /nastroje → Reklamy), viz docs/ADS.md.
# Token systémového uživatele z Business Manageru Taveo (oprávnění ads_read).
# Klienti nám účet nasdílí jako partnerovi, jejich tokeny neukládáme.
META_SYSTEM_USER_TOKEN=
# Tajný klíč Meta aplikace, podepisuje volání (appsecret_proof). Doporučeno.
META_APP_SECRET=
META_API_VERSION=v25.0
# Google Ads: OAuth klient z Google Cloud projektu, refresh token uživatele
# s přístupem k MCC Taveo a číslo MCC. Developer token jen pokud ho API chce.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_API_VERSION=v24
# GA4: klíč servisního účtu (celý JSON nebo cesta k souboru mimo public/).
GA4_CREDENTIALS=
# Ukázkoví klienti s vymyšlenými čísly. Po napojení skutečných účtů vypnout.
ADS_DEMO=true

# Cloudflare Turnstile — ochrana poptávkového formuláře proti robotům.
# Klíče vytvoříš v Cloudflare → Turnstile → Add widget pro doménu taveo.cz.
# Prázdné klíče ochranu vypnou: formulář jede dál, jen bez ověření.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
