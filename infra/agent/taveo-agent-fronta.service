[Unit]
Description=Zpracování fronty agenta TAVEO
# Bez stropu spuštění: výchozí 5 za 10 s frontu po pár rychlých požadavcích
# (nové projekty klientů) vypne a dál nic nezpracuje (26. 10. 2026).
StartLimitIntervalSec=0

[Service]
Type=oneshot
# Limity (FRONTA_LIMIT_MIN) jsou ve stejném souboru jako u služby v kontejneru.
EnvironmentFile=-/srv/agent/terminal.env
ExecStart=/usr/bin/python3 /srv/agent/docker/agent-fronta.py
