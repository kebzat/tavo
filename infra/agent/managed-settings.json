{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "remoteControlAtStartup": true,
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(*artisan tinker*)",
      "Bash(*artisan db:seed*)",
      "Bash(*artisan settings:*)",
      "Bash(*artisan migrate*)",
      "Bash(wp db *)",
      "Bash(wp search-replace *)",
      "Bash(wp * create *)",
      "Bash(wp * update *)",
      "Bash(wp * delete *)",
      "Bash(wp * set *)",
      "Bash(wp * add *)",
      "Bash(wp * import *)",
      "Bash(rm *)",
      "Bash(git push *)"
    ],
    "ask": [
      "Bash(composer update*)",
      "Bash(composer require*)",
      "Bash(npm install *)",
      "Bash(curl * -X *)",
      "Bash(curl * --data*)",
      "Bash(curl * -d *)"
    ],
    "deny": [
      "Bash(*migrate:fresh*)",
      "Bash(*migrate:reset*)",
      "Bash(*migrate:refresh*)",
      "Bash(*db:wipe*)",
      "Bash(*DROP DATABASE*)",
      "Bash(*DROP TABLE*)",
      "Bash(*TRUNCATE*)",
      "Bash(*drop database*)",
      "Bash(*drop table*)",
      "Bash(*truncate table*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf .)",
      "Bash(rm -rf ./)",
      "Bash(rm -rf *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Read(//**/.ssh/**)",
      "Edit(//**/.ssh/**)",
      "Edit(//**/.env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/zaloha-pred-zmenou",
            "timeout": 150
          }
        ]
      }
    ]
  }
}
